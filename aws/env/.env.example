# =================================================================
# 1. 인프라 공통 설정 (Kafka, DB, Redis)
# =================================================================
# EC2 퍼블릭 IP 주소
EC2_PUBLIC_IP=

# 데이터베이스 설정 (PostgreSQL)
# 한 서버에 다 있으면 HOST는 서비스 이름인 'postgres' 또는 'db'를 씁니다. -> 다른 서버 사용 시 ec2-airflow-main IP로 변경
DB_ENGINE=
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=

# Redis 설정
# 한 서버에 있으므로 서비스명 'redis' 사용
# Redis가 있는 EC2 인스턴스의 퍼블릭 IP 주소를 여기에 입력하세요.
REDIS_HOST=
REDIS_LOCATION=

# Kafka 설정
KAFKA_BOOTSTRAP_SERVERS=

# =================================================================
# 2. Airflow 전용 설정
# =================================================================
AIRFLOW_IMAGE_NAME=
# main, worker 동일하게 맞춤
AIRFLOW_UID=
FERNET_KEY=
# [Logging]
LOG_LEVEL=

# Airflow worker 설정
AIRFLOW__CORE__PARALLELISM=
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=

# =================================================================
# 3. 외부 서비스 API & 스토리지 (Nexon, AWS, R2)
# =================================================================
# Nexon API
NEXON_API_KEY=

# AWS S3 (S3 Sink용)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
S3_BUCKET=

# Cloudflare R2 & CDN (Django용)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
CDN_BASE_URL=